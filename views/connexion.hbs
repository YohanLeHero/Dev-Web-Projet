<section class="auth">
    <h2>Connexion</h2>

    {{#if erreur}}<p class="erreur">{{erreur}}</p>{{/if}}

    <form method="POST" action="/connexion">
        <label>Pseudo
            <input type="text" name="pseudo" value="{{pseudo}}" required>
        </label>
        <label>Mot de passe
            <input type="password" name="mdp" required>
        </label>
        <button type="submit">Se connecter</button>
    </form>
</section>